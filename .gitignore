# Generated by the engine
Binaries/
Intermediate/
Saved/
DerivedDataCache/
Build/

# IDE
.vs/
.idea/
.agents/
*.sln
*.suo
*.VC.db
*.VC.opendb
Plugins/Developer/RiderLink
*.DotSettings.user

# One-off Unreal inspection exports and local scripts
/*.t3d
/inspect_*.py
/test_unreal_python.py
/verify_assets.py
/out.txt

# Engine-generated project files
*.xcodeproj
*.xcworkspace

# Compiled objects and libraries
*.o
*.obj
*.pdb
*.lib
*.dll
*.exe

# Raw source art
SourceArt/**/*.png
SourceArt/**/*.tga

# Auto-generated by the editor — never commit
Content/Collections/
Content/Developers/
Content/__ExternalActors__/
Content/__ExternalObjects__/

# Only project-authored content is versioned. Marketplace packs live in
# Content/ThirdParty/ and are required locally (see Docs/ARCHITECTURE.md),
# but are deliberately kept out of the repository.
Content/*
!Content/IronField/
!Content/IronField/**
